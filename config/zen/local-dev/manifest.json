{
  "manifest_version": 2,
  "name": "Local Dev",
  "version": "1.0.0",
  "description": "Dev tools for local sites: hazard-tape tabs and a toolbar with port switching, errors, requests and storage.",
  "browser_specific_settings": {
    "gecko": {
      "id": "local-dev@apepin.dev",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "*://localhost/*",
    "*://*.localhost/*",
    "*://127.0.0.1/*",
    "*://*.test/*",
    "browsingData",
    "cookies"
  ],
  "optional_permissions": [
    "*://*/*"
  ],
  "background": {
    "scripts": [
      "patterns.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": false,
    "open_in_tab": false
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Local Dev settings",
    "default_popup": "options.html"
  }
}
