// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "markdown_preview_font_size": 14.0,
  "markdown_preview_code_font_family": "FiraCode Nerd Font",
  "markdown_preview_font_family": ".SystemUIFont",
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "languages": {
    "Markdown": {
      "format_on_save": "on"
    }
  },
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "gutter": {
    "folds": true
  },
  "show_whitespaces": "all",
  "autosave": "on_focus_change",
  "restore_on_startup": "empty_tab",
  "default_open_behavior": "new_window",
  "cli_default_open_behavior": "existing_window",
  "use_system_window_tabs": true,
  "buffer_font_weight": 300.0,
  "ui_font_family": ".ZedMono",
  "project_panel": {
    "auto_fold_dirs": false,
    "hide_hidden": false,
    "hide_root": false,
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "bold_folder_labels": false,
    "folder_icons": false,
    "file_icons": true,
    "entry_spacing": "standard",
    "dock": "left"
  },
  "outline_panel": {
    "auto_fold_dirs": false,
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "vim_mode": false,
  "base_keymap": "JetBrains",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 14.0,
  // "ui_font_family": "Fira Code",
  "buffer_font_size": 12.0,
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "terminal": {
    "font_family": "FiraCode Nerd Font Mono"
  }
}
