# Prepend a directory to $PATH if it isn't already there
function append_path {
  case ":$PATH:" in
    *":$1:"*) :;;        # already there
    *) PATH="$1:$PATH";; # prepend
  esac
}

# Shared PATH entries
append_path "$DOTFILES/bin"
append_path "$HOME/.local/bin"
append_path "$HOME/.composer/vendor/bin"

# Editor
export DEFAULT_TEXT_EDITOR="zed"

# Starship reads ~/.config/starship.toml by default; our config lives in a subdir
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"

# OrbStack Docker socket (both machines run OrbStack)
export DOCKER_HOST="unix://$HOME/.orbstack/run/docker.sock"

# Zoxide - A fast directory navigation tool
command -v zoxide &> /dev/null && eval "$(zoxide init zsh)"

# --- Language / version managers (installed on both machines; guarded) ---

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
if command -v pyenv &> /dev/null; then
  [[ -d "$PYENV_ROOT/bin" ]] && append_path "$PYENV_ROOT/bin"
  eval "$(pyenv init - zsh)"
  command -v pyenv-virtualenv-init &> /dev/null && eval "$(pyenv virtualenv-init -)"
fi

# rbenv
command -v rbenv &> /dev/null && eval "$(rbenv init - zsh)"

# fnm (fast node manager) — Rust-based, far faster shell startup than nvm
command -v fnm &> /dev/null && eval "$(fnm env --use-on-cd)"

# bun
export BUN_INSTALL="$HOME/.bun"
append_path "$BUN_INSTALL/bin"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# thefuck — lazy-load: `thefuck --alias` spawns Python (~130ms), so defer it to
# first use. The bootstrap `fuck` replaces itself with the real alias on first call.
if command -v thefuck &> /dev/null; then
  fuck() {
    unfunction fuck
    eval "$(thefuck --alias)"
    fuck "$@"
  }
fi

# Homebrew perl local::lib
[ -d "$HOME/perl5" ] && eval "$(perl -I"$HOME/perl5/lib/perl5" -Mlocal::lib="$HOME/perl5")"
